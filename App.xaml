<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VitoTodoList"
             x:Class="VitoTodoList.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Yellow Sticky Note Color Palette -->
            <Color x:Key="Primary">#FFEB3B</Color>
            <Color x:Key="PrimaryDark">#FDD835</Color>
            <Color x:Key="PrimaryLight">#FFF9C4</Color>
            <Color x:Key="Accent">#FFD700</Color>
            <Color x:Key="AccentDark">#FFC107</Color>
            <Color x:Key="Background">#FFFFF3</Color>
            <Color x:Key="Surface">#FFFFEB</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="DeadlineRed">#F44336</Color>
            
            <!-- Styles -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
            </Style>
            
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryDark}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentDark}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderColor" Value="{StaticResource Accent}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
            </Style>
            
            <Style TargetType="Editor">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
            </Style>
            
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>
            
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryDark}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HasShadow" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
