<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitoTodoList.TodoEditPage"
             Title="{Binding PageTitle}">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Title" FontAttributes="Bold"/>
            <Entry x:Name="TitleEntry" Placeholder="Enter todo title" MaxLength="200"/>

            <Label Text="Description" FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor" Placeholder="Enter description (optional)" HeightRequest="100"/>

            <Label Text="Deadline (Optional)" FontAttributes="Bold"/>
            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="HasDeadlineCheckBox" CheckedChanged="OnHasDeadlineChanged"/>
                <Label Text="Set deadline" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <DatePicker x:Name="DeadlineDatePicker" 
                       IsVisible="{Binding Source={x:Reference HasDeadlineCheckBox}, Path=IsChecked}"
                       MinimumDate="{x:Static x:DateTime.Now}"/>

            <TimePicker x:Name="DeadlineTimePicker"
                       IsVisible="{Binding Source={x:Reference HasDeadlineCheckBox}, Path=IsChecked}"/>

            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Save" 
                       Clicked="OnSaveClicked"
                       BackgroundColor="{StaticResource Primary}"
                       HorizontalOptions="FillAndExpand"/>
                <Button Text="Cancel" 
                       Clicked="OnCancelClicked"
                       HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
